# Never upload secrets or the local database
.env
chroma_db/
__pycache__/
*.pyc
venv/

# Login accounts (password hashes) — never commit
config/

# Workspace documents (other companies' data) — never commit
data/

# Copies synced from connectors (Google Drive, Notion) — private, never commit
docs/connectors/

# Impeccable design-skill working files (screenshots, decision rounds); its
# PRODUCT/DESIGN records and surface briefs are committed.
.impeccable/review/
.impeccable/decision/
.impeccable/questions/
.impeccable/mocks/
.impeccable/config.local.json

# Answer-evaluation runs (python evaluate.py) - local comparisons, not committed
eval/results/

# The old Guardrails Hub token (no longer used, deploy.md): never commit one a server still has
guardrails_token.secret

# deploy.sh state: the running and previous version, history, database copies
.deploy/
