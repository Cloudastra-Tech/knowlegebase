# Copy this file to ".env" and paste your real key after the = sign.
# Get a key at: https://platform.openai.com/api-keys
# Keep .env SECRET. Never commit it to git.

OPENAI_API_KEY=sk-paste-your-key-here

# ---- Outline wiki (internal knowledge base) ----
# Your self-hosted Outline URL (no trailing slash).
OUTLINE_URL=https://app.cloudastra.co
# Create an API token in Outline: Settings -> API Tokens. Keep it SECRET.
OUTLINE_API_TOKEN=ol_api_paste-your-token-here
# If your Outline is behind Cloudflare Access (Zero Trust), create a Service
# Token (Zero Trust -> Access -> Service Auth) and paste both values here.
# Leave blank if your instance is NOT behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- Public address ----
# The https:// address people open (no trailing slash). Google / Microsoft send
# the browser back here after sign-in, and Google Drive / Notion after connecting.
PUBLIC_URL=

# ---- Single sign-on (sso.py) ----
# Who may sign in, and who is HR / Admin, is set with `python auth.py` — see deploy.md.
# Google: an OAuth client of type "Web application" (Google Cloud -> APIs & Services
# -> Credentials). Also used by the Google Drive integration. Redirect URIs:
#   <PUBLIC_URL>/api/auth/sso/google/callback
#   <PUBLIC_URL>/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: an app registration in Entra ID (single tenant).
# Redirect URI (Web): <PUBLIC_URL>/api/auth/sso/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Any other OpenID Connect provider (Okta, Keycloak, Auth0, Authentik, ...).
# List ids (lowercase letters/digits), then set ISSUER / CLIENT_ID / CLIENT_SECRET
# for each. Redirect URI to register: <PUBLIC_URL>/api/auth/sso/<id>/callback
# Only add providers your organisation controls (see deploy.md, step 4c).
OIDC_PROVIDERS=
# OIDC_OKTA_ISSUER=https://dev-123456.okta.com/oauth2/default
# OIDC_OKTA_CLIENT_ID=
# OIDC_OKTA_CLIENT_SECRET=
# OIDC_OKTA_LABEL=Okta
# Signs the short-lived sign-in cookie. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set to "off" to allow single sign-on only (no username + password form).
PASSWORD_LOGIN=on
