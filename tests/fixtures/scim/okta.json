{
  "source": "https://developer.okta.com/docs/api/openapi/okta-scim/guides/scim-20",
  "note": "Request bodies copied from Okta's 'SCIM 2.0 protocol reference' (fetched 2026-10-27). The test replaces okta.local with its own verified domain and Okta's example ids with the ones this server gave.",
  "requests": {
    "find_user": {
      "method": "GET",
      "path": "/scim/v2/Users?filter=userName%20eq%20%22test.user%40okta.local%22&startIndex=1&count=100"
    },
    "create_user": {
      "method": "POST",
      "path": "/scim/v2/Users",
      "body": {
        "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
        "userName": "test.user@okta.local",
        "name": {"givenName": "Test", "familyName": "User"},
        "emails": [{"primary": true, "value": "test.user@okta.local", "type": "work"}],
        "displayName": "Test User",
        "locale": "en-US",
        "externalId": "00ujl29u0le5T6Aj10h7",
        "groups": [],
        "password": "1mz050nq",
        "active": true
      }
    },
    "replace_user": {
      "method": "PUT",
      "path": "/scim/v2/Users/23a35c27-23d3-4c03-b4c5-6443c09e7173",
      "body": {
        "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
        "id": "23a35c27-23d3-4c03-b4c5-6443c09e7173",
        "userName": "test.user@okta.local",
        "name": {"givenName": "Another", "middleName": "Excited", "familyName": "User"},
        "emails": [{"primary": true, "value": "test.user@okta.local", "type": "work",
                    "display": "test.user@okta.local"}],
        "active": true,
        "groups": [],
        "meta": {"resourceType": "User"}
      }
    },
    "deactivate_user": {
      "method": "PATCH",
      "path": "/scim/v2/Users/23a35c27-23d3-4c03-b4c5-6443c09e7173",
      "body": {
        "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
        "Operations": [{"op": "replace", "value": {"active": false}}]
      }
    },
    "reactivate_user": {
      "method": "PATCH",
      "path": "/scim/v2/Users/23a35c27-23d3-4c03-b4c5-6443c09e7173",
      "note": "Okta's page shows deactivation only; reactivation is the same op with active true.",
      "body": {
        "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
        "Operations": [{"op": "replace", "value": {"active": true}}]
      }
    },
    "create_group": {
      "method": "POST",
      "path": "/scim/v2/Groups",
      "body": {
        "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
        "displayName": "Test SCIMv2",
        "members": []
      }
    },
    "find_group": {
      "method": "GET",
      "path": "/scim/v2/Groups?filter=displayName%20eq%20%22Test%20SCIMv2%22&startIndex=1&count=100"
    },
    "rename_group": {
      "method": "PATCH",
      "path": "/scim/v2/Groups/abf4dd94-a4c0-4f67-89c9-76b03340cb9b",
      "body": {
        "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
        "Operations": [{"op": "replace",
                        "value": {"id": "abf4dd94-a4c0-4f67-89c9-76b03340cb9b",
                                  "displayName": "Test SCIMv2"}}]
      }
    },
    "group_members": {
      "method": "PATCH",
      "path": "/scim/v2/Groups/abf4dd94-a4c0-4f67-89c9-76b03340cb9b",
      "body": {
        "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
        "Operations": [
          {"op": "remove", "path": "members[value eq \"89bb1940-b905-4575-9e7f-6f887cfb368e\"]"},
          {"op": "add", "path": "members",
           "value": [{"value": "23a35c27-23d3-4c03-b4c5-6443c09e7173",
                      "display": "test.user@okta.local"}]}
        ]
      }
    },
    "replace_members": {
      "method": "PATCH",
      "path": "/scim/v2/Groups/abf4dd94-a4c0-4f67-89c9-76b03340cb9b",
      "body": {
        "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
        "Operations": [{"op": "replace", "path": "members",
                        "value": [{"value": "23a35c27-23d3-4c03-b4c5-6443c09e7173",
                                   "display": "test.user@okta.local"},
                                  {"value": "89bb1940-b905-4575-9e7f-6f887cfb368e",
                                   "display": "test.user@okta.local"}]}]
      }
    },
    "replace_group": {
      "method": "PUT",
      "path": "/scim/v2/Groups/abf4dd94-a4c0-4f67-89c9-76b03340cb9b",
      "body": {
        "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
        "displayName": "Test SCIMv2",
        "members": [{"value": "23a35c27-23d3-4c03-b4c5-6443c09e7173",
                     "display": "test.user@okta.local"}]
      }
    },
    "delete_group": {
      "method": "DELETE",
      "path": "/scim/v2/Groups/abf4dd94-a4c0-4f67-89c9-76b03340cb9b"
    }
  }
}
